// Synthetic CT fixture. Explicit f32 global pointer parameter profile.
.version 7.0
.target sm_50
.address_size 64
.visible .entry relu(
    .param .u64 .ptr .global .align 4 a,
    .param .u64 .ptr .global .align 4 c,
    .param .u32 n
) {
    .reg .pred %p<2>;
    .reg .b32 %r<5>;
    .reg .b64 %rd<7>;
    .reg .f32 %f<3>;
    ld.param.u32 %r0, [n];
    mov.u32 %r1, %ctaid.x;
    mov.u32 %r2, %ntid.x;
    mov.u32 %r3, %tid.x;
    mad.lo.u32 %r4, %r1, %r2, %r3;
    setp.ge.u32 %p0, %r4, %r0;
    @%p0 bra DONE;
    ld.param.u64 %rd1, [a];
    ld.param.u64 %rd3, [c];
    mul.wide.u32 %rd0, %r4, 4;
    add.u64 %rd4, %rd1, %rd0;
    add.u64 %rd6, %rd3, %rd0;
    ld.global.f32 %f0, [%rd4];
    setp.lt.f32 %p1, %f0, 0f00000000;
    selp.f32 %f2, 0f00000000, %f0, %p1;
    st.global.f32 [%rd6], %f2;
DONE:
    ret;
}
